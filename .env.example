# Anthropic
ANTHROPIC_API_KEY=

# Postgres / pgvector (matches docker-compose.yml defaults)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
# Note: mapped to host port 5433, not 5432 — this machine has a native
# PostgreSQL service already bound to 5432.
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5433/sentinel

# Langfuse Cloud (free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Enrichment tools (added Day 6, listed here so the key list stays in one place)
NVD_API_KEY=
ABUSE_CH_API_KEY=
