# LLM providers. Dev runs on a free OpenRouter model; Claude comes back for the official numbers.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# LangChain "provider:model". Changing it invalidates earlier eval numbers: re-run the baseline.
SENTINEL_TRIAGE_MODEL=openrouter:nvidia/nemotron-3-super-120b-a12b:free
# Tier 2: re-runs the alert when tier 1 is unsure. "none" = tier 1 only.
SENTINEL_ESCALATION_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# Escalate when tier-1 confidence is below this (also on needs_review / TP without technique).
SENTINEL_ESCALATE_BELOW=0.7

# Postgres / pgvector (matches docker-compose.yml defaults)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
# Note: mapped to host port 5433, not 5432 — this machine has a native
# PostgreSQL service already bound to 5432.
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5433/sentinel

# Langfuse Cloud (free Hobby tier, EU region). Leave keys empty to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Who is running (traces get an owner:<name> tag). Empty = git config user.name.
SENTINEL_OWNER=

# Enrichment tools (added Day 6, listed here so the key list stays in one place)
NVD_API_KEY=
ABUSE_CH_API_KEY=
# "frozen" = reuse cached tool answers forever (eval runs); empty = normal TTLs (NVD 7d, ThreatFox 1d)
SENTINEL_TOOL_CACHE=
